{
  "name": "dsh-agy-provider",
  "version": "0.6.1",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "Expose the locally authenticated AGY CLI as a DSH model provider.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./mock": {
      "types": "./lib/provider/mock.d.ts",
      "default": "./lib/provider/mock.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-agy-provider": "bin/dsh-agy-provider.js"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "bin/**/*.js",
    "agents/**/*.md",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkings/dsh-agy-provider.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/run-tests.mjs",
    "diagnose": "npm run build && node scripts/diagnose.mjs",
    "smoke:dsh": "node scripts/dsh-smoke.mjs",
    "smoke:dsh:self-contained": "npm run build && node scripts/dsh-smoke-self-contained.mjs",
    "agy:protocol": "npm run build && node scripts/agy-protocol-experiment.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "quota:experiment": "npm run build && node scripts/quota-experiment.mjs",
    "image:experiment": "npm run build && node scripts/image-protocol-experiment.mjs",
    "verify": "npm run typecheck && npm test && npm pack --dry-run",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-attachment": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-brand": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-brand": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.7"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "tests"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/darkings/dsh-agy-provider/issues"
  },
  "homepage": "https://github.com/darkings/dsh-agy-provider#readme"
}
